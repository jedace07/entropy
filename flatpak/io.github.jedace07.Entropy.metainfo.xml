<component type="desktop-application">
  <id>io.github.jedace07.Entropy</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>

  <name>Entropy</name>
  <summary>Upscale and resize images locally</summary>
  <developer id="io.github.jedace07">
    <name>jedace07</name>
  </developer>

  <description>
    <p>
      Entropy enlarges images with the Real-ESRGAN General 4× model, running on
      your GPU through OpenCL. Everything runs on your computer and images are
      never uploaded.
    </p>
    <ul>
      <li>Upscale by up to 4×, or pick any size in between</li>
      <li>Downscale with high-quality resizing, no GPU required</li>
      <li>Process a batch of PNG, JPEG, WebP, TIFF and BMP images</li>
      <li>Compare the original and the result side by side</li>
      <li>Results are saved as PNG without overwriting existing files</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.jedace07.Entropy.desktop</launchable>
  <provides>
    <binary>entropy</binary>
  </provides>

  <url type="homepage">https://github.com/jedace07/entropy</url>
  <url type="bugtracker">https://github.com/jedace07/entropy/issues</url>
  <url type="vcs-browser">https://github.com/jedace07/entropy</url>

  <branding>
    <color type="primary" scheme_preference="light">#ede8ff</color>
    <color type="primary" scheme_preference="dark">#3a2c78</color>
  </branding>

  <screenshots>
